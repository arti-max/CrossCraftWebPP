<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrossCraft</title>
    
    <!-- Предзагрузка текстур -->
    <link rel="preload" as="image" href="terrain.png">
    <link rel="preload" as="image" href="char.png">
    <link rel="preload" as="image" href="rock.png">
    <link rel="preload" as="image" href="rock2.png">
    <link rel="preload" as="image" href="dirt.png">
    <link rel="preload" as="image" href="water.png">
    <link rel="preload" as="image" href="default.png">
    <link rel="preload" as="image" href="clouds.png">
    <link rel="preload" as="image" href="gui.png">
    
    <style>
        /* === ОРИГИНАЛЬНЫЙ СТИЛЬ MINECRAFT (2010) === */
        
        body, html {
            border: none;
            margin: 0;
            padding: 0;
            background-color: #222;
            color: #e0d0d0;
            /* Используем твой rock.png, но с затемнением как просил ранее */
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('rock.png');
            background-repeat: repeat;
            /* Увеличиваем текстуру для аутентичности */
            background-size: 96px 96px; 
            image-rendering: pixelated;
            
            font-weight: normal;
            font-family: sans-serif;
            height: 100%;    
        }

        a:link { color: #aaf; }
        a:hover { color: #fff; }
        a:visited { color: #aaa; }
        a:active { color: #ff0; }

        #content {
            margin-left: auto;
            margin-right: auto;
            /* Оригинал был 854px, но т.к. канвас 1024px, ставим ширину под него */
            width: 1024px; 
            text-align: left;
        }

        #footer {
            text-align: center;
            font-size: 10px;
            height: 10px;
            padding-top: 2px;
            padding-bottom: 2px;
            position: fixed;
            bottom: 2px;
            right: 2px;
            z-index: 1000;
        }

        /* === ТЕХНИЧЕСКИЕ СТИЛИ ДЛЯ ВЕБ-КЛИЕНТА === */
        
        #app {
            width: 1024px;
            height: 576px;
            background-color: #000;
            position: relative;
            box-shadow: 0 0 20px rgba(0,0,0,0.5); /* Немного тени для выделения на фоне */
            display: block; /* Убираем пробелы под канвасом */
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            outline: none;
        }

        #loading-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: #1a1a1a;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .loader {
            border: 5px solid #333;
            border-top: 5px solid #fff;
            border-radius: 50%;
            width: 40px; height: 40px;
            animation: spin 1s linear infinite;
            margin-bottom: 15px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        #output {
            width: 100%;
            height: 100px;
            background-color: #2d2d2d;
            color: #00ff00;
            font-family: monospace;
            margin-top: 10px;
            padding: 5px;
            overflow-y: auto;
            border: 1px solid #555;
            font-size: 12px;
            display: none;
        }

        /* Скрываем ресурсы */
        #texture-atlases { display: none; }
    </style>
</head>
<body>
    <a id="back-link" href="/">Back to home</a>
    
    
    <div id="content">
        
        <br><br><br>

        <!-- Предупреждение о логине -->
        <center>
            <font color="#ff0000" id="nologin-warning" style="display:none;">
                You won't be able to save unless you log in.
            </font>
        </center>
        
        <br>

        <!-- ИГРОВОЙ КОНТЕЙНЕР (Заменяет Applet) -->
        <div id="app">
            <div id="loading-screen">
                <div class="loader"></div>
                <div style="color: #aaa; font-size: 14px;">Loading resources...</div>
            </div>
            <canvas id="canvas" tabindex="0" oncontextmenu="event.preventDefault()"></canvas>
        </div>
        
        <br>

        <center>
            <font size="-1">
                This game requires a browser with WebGL and WASM. Press escape to release the mouse.
            </font>
        </center>
        <center><font size="+1">Press B!</font></center>
        
        <br>
        
        <h2>Controls:</h2>
        WASD to move<br>
        Space to jump<br>
        R to respawn at the spawn point.<br>
        Enter to set a new spawn point.<br>
        B to open the inventory<br>
        F to toggle fog distance<br>
        Escape to release mouse and open game menu<br>
        1-9 or scrollwheel to change building block type<br>
        Left mouse button to add a block<br>
        Right mouse button to remove a block<br>
        Middle mouse button to copy block type<br>
        
        <h2>In multiplayer:</h2>
        Tab to list players<br>
        T to chat<br>
        
        <!-- Консоль отладки (скрыта) -->
        <div id="output"></div>

    </div>

    <div id="footer">
        Copyright 2025-2026 CrossCraft. 
        <a href="#">Terms and conditions</a>. 
        <a href="#">Credits</a>. 
        For support, dm<a href="#">artinzz_ in discord</a>
    </div>

    <!-- Скрытые текстуры для загрузки -->
    <div id="texture-atlases">
        <img id="terrain" src="terrain.png" crossorigin="anonymous" />
        <img id="default" src="default.png" crossorigin="anonymous" />
        <img id="char" src="char.png" crossorigin="anonymous" />
        <img id="dirt" src="dirt.png" crossorigin="anonymous" />
        <img id="rock" src="rock.png" crossorigin="anonymous" />
        <img id="rock2" src="rock2.png" crossorigin="anonymous" />
        <img id="water" src="water.png" crossorigin="anonymous" />
        <img id="clouds" src="clouds.png" crossorigin="anonymous" />
        <img id="gui" src="gui.png" crossorigin="anonymous" />
    </div>

    <script type='text/javascript'>
        function resizeGame() {
        const wrapper = document.getElementById('content');
        const windowWidth = window.innerWidth;
        
        // Если экран меньше 1024px, масштабируем весь контент вниз
        if (windowWidth < 1044) { // 1024 + margin
            let scale = windowWidth / 1044;
            // Используем zoom для старых браузеров или transform origin
            wrapper.style.transform = `scale(${scale})`;
            wrapper.style.transformOrigin = `top center`;
            wrapper.style.marginTop = "0px";
        } else {
            wrapper.style.transform = "none";
            wrapper.style.marginTop = "";
        }
    }

        window.addEventListener('resize', resizeGame);
        // Вызываем сразу
        resizeGame();

        const DEBUG = false;
        // Получаем URL параметры
        const urlParams = new URLSearchParams(window.location.search);
        const username = urlParams.get('username');
        const sessionid = urlParams.get('sessionid');
        const loadmapUser = urlParams.get('loadmap_user');
        const loadmapId = urlParams.get('loadmap_id');
        const fullscreen = urlParams.get('fullscreen');
        const server = urlParams.get('server') || '';
        const port = parseInt(urlParams.get('port') || '0');

        if (DEBUG) {
            document.getElementById('output').style.display = "block";
        }

        if (!username || !sessionid) {
            document.getElementById('nologin-warning').style.display = "inline";
        }

        const appContainer = document.getElementById('app');
        const canvas = document.getElementById('canvas');

        let targetWidth = 1024;
        let targetHeight = 576;
        const aspectRatio = targetWidth / targetHeight;

        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;

        if (windowWidth < targetWidth + 20) {
            targetWidth = windowWidth - 20; 
            targetHeight = Math.floor(targetWidth / aspectRatio);
            console.log("Mobile device detected, resizing to:", targetWidth, targetHeight);
        }
        appContainer.style.width = `${targetWidth}px`;
        appContainer.style.height = `${targetHeight}px`;
        canvas.width = targetWidth;
        canvas.height = targetHeight;

        console.log(`CrossCraft: Canvas initialized ${targetWidth}x${targetHeight}`);
        if (username && sessionid) {
            console.log(`Game started with username: ${username}, sessionid: ${sessionid}`);
        }

        // Ждем загрузки всех изображений
        let imagesToLoad = ['terrain', 'char', 'dirt', 'rock', 'rock2', 'water', 'default', 'clouds', 'gui'];
        let loadedCount = 0;
        
        function checkAllImagesLoaded() {
            loadedCount++;
            console.log(`Loaded image ${loadedCount}/${imagesToLoad.length}`);
            if (loadedCount === imagesToLoad.length) {
                console.log('All images loaded, starting game...');
                // Игра запустится через Module.onRuntimeInitialized
            }
        }

        imagesToLoad.forEach(id => {
            const img = document.getElementById(id);
            if (img.complete) {
                checkAllImagesLoaded();
            } else {
                img.onload = checkAllImagesLoaded;
                img.onerror = () => console.error(`Failed to load image: ${id}`);
            }
        });

        // Настройка Emscripten Module
        var Module = {
            canvas: canvas,
            preRun: [],
            postRun: [],
            
            print: (function() {
                var element = document.getElementById('output');
                if (element) element.innerHTML = '';
                return function(text) {
                    if (arguments.length > 1) text = Array.prototype.slice.call(arguments).join(' ');
                    console.log(text);
                    if (element) {
                        element.innerHTML += text + "<br>";
                        element.scrollTop = element.scrollHeight;
                    }
                };
            })(),
            
            printErr: function(text) {
                if (arguments.length > 1) text = Array.prototype.slice.call(arguments).join(' ');
                console.error(text);
            },

            onRuntimeInitialized: async function() {
                const loadingScreen = document.getElementById('loading-screen');
                if (loadingScreen) {
                    loadingScreen.style.display = 'none';
                }

                console.log('WebAssembly runtime initialized');
                
                try {
                    await Module.ccall('testAsyncify', 'void', [], [], {async: true});
                } catch (e) {
                    console.error('Asyncify test failed', e);
                }
                
                console.log('Calling setAppletParams with:', username, sessionid);
                try {
                    console.log(`Setting params: ${targetWidth}x${targetHeight}`);
                    Module.ccall('setAppletParams', 'void', 
                        ['string', 'string', 'string', 'number', 'number', 'number'],
                        [username || "", sessionid || "", loadmapUser || "", (parseInt(loadmapId) >= 0 && parseInt(loadmapId) <= 4 ? parseInt(loadmapId) : -1 ), targetWidth, targetHeight]
                    );
                    
                    if (server && port > 0) {
                        Module.ccall('setServerParams', null, ['string', 'number'], [server, port]);
                    }
                } catch (e) {
                    console.error('Error calling setAppletParams:', e);
                }
                
                await new Promise(resolve => setTimeout(resolve, 100));
                
                console.log('Starting applet...');
                try {
                    await Module.ccall('startApplet', 'void', [], [], {async: true});
                    console.log('Applet started successfully');
                } catch (e) {
                    console.error('Error calling startApplet:', e);
                }
            }
        };

        function debugInfo() {
            if (typeof Module !== 'undefined' && Module.ccall) {
                try {
                    // Можешь добавить debug функцию в C++
                    console.log('Debug info requested');
                } catch(e) {
                    console.error('Debug error:', e);
                }
            }
        }
        
        window.onerror = function(event, source, lineno, colno, error) {
            console.error("Global error caught:", error);
            
            try {
                if (Module && Module.pauseMainLoop) Module.pauseMainLoop();
            } catch(e) {}

            var msg = event.toString();
            if (error && error.message) msg = error.message;
            
            var app = document.getElementById('app');
            
            var errorHtml = `
                <div style="
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: linear-gradient(to bottom, #6b1412 0%, #3d0505 100%);
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    color: white;
                    text-align: center;
                    z-index: 9999;
                    pointer-events: auto;
                    cursor: default;
                ">
                    <div style="
                        font-size: 24px; 
                        margin-bottom: 20px; 
                        text-shadow: 2px 2px 0px #000;
                        font-weight: bold;
                    ">Runtime Error</div>
                    
                    <div style="
                        font-size: 14px; 
                        color: #cccccc;
                        text-shadow: 1px 1px 0px #000;
                        max-width: 80%;
                        word-wrap: break-word;
                    ">${msg}</div>
                </div>
            `;
            
            app.style.position = 'relative';
            app.innerHTML += errorHtml;
            
            return true;
        };

        var gameCanvas = document.getElementById('canvas');
    
        if (gameCanvas) {
            gameCanvas.addEventListener('keydown', function(e) {
                // Блокируем стрелки всегда (они скроллят, но в чате обычно не нужны для ввода текста, только для навигации)
                if ([37, 38, 39, 40, 33, 34, 35, 36].indexOf(e.keyCode) > -1) {
                    e.preventDefault();
                }
                
                // ПРОБЕЛ (32): Блокируем ТОЛЬКО если курсор захвачен (мы играем)
                // Если курсор свободен (мы в чате/меню) - НЕ блокируем, чтобы работал ввод текста.
                if (e.keyCode === 32) {
                    if (document.pointerLockElement === gameCanvas) {
                        e.preventDefault(); // Блокируем скролл (и ввод), т.к. это прыжок
                    }
                    // Иначе (в чате) - ничего не делаем, браузер вводит пробел.
                    // ДА, это может вызвать скролл страницы, если она длинная.
                    // Но зато чат будет работать.
                }
            }, false);

            gameCanvas.addEventListener('wheel', function(e) {
                e.preventDefault();
            }, { passive: false });

            gameCanvas.addEventListener('mousedown', function() {
                gameCanvas.focus();
            });
        }
    </script>

    <script async type="text/javascript" src="game.js"></script>
</body>
</html>
