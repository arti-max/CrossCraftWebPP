{
    "configurations": [
        {
            "name": "Emscripten",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/lib/stb",
                "${env:HOME}/.cache/emscripten/sysroot/include",
                "/usr/lib/emscripten/cache/sysroot/include"
            ],
            "defines": [
                "_DEBUG",
                "EMSCRIPTEN",
                "__EMSCRIPTEN__"
            ],
            "compilerPath": "/usr/lib/emscripten/emcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-clang-x64"
        }
    ],
    "version": 4
}